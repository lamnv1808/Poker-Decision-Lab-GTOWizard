# PostgreSQL connection (Render/Supabase/Neon managed Postgres in production)
DATABASE_URL=postgresql://pdl:pdl@localhost:5432/pdl_dev
# Secret for signing Math Lab quiz tokens (openssl rand -hex 32). Required in production.
APP_SECRET=change-me-in-production
# production | development | test
NODE_ENV=development
PORT=8080
# Comma-separated origins allowed to call the API with credentials (dev: Vite at 5173)
CORS_ORIGINS=http://localhost:5173
