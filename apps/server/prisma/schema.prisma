// Poker Decision Lab — PostgreSQL schema.
// Principles: versioned scenario content, immutable attempt records, reproducible
// rating updates (one RatingHistory row per attempt+skill, unique), per-user isolation
// (every user-owned row carries userId and every query filters by it).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())

  sessions       Session[]
  preference     UserPreference?
  trainingSessions TrainingSession[]
  runs           ScenarioRun[]
  attempts       DecisionAttempt[]
  ratings        Rating[]
  ratingHistory  RatingHistory[]
  leakObservations LeakObservation[]
  reviewItems    ReviewItem[]
  bookmarks      Bookmark[]
  notes          UserNote[]
  importedFiles  ImportedFile[]
  tournaments    Tournament[]
  hands          HandHistory[]
  importErrors   ImportError[]
  realHands      RealHand[]
  realDecisions  RealDecision[]
  annotations    Annotation[] @relation("AnnotationOwner")
  simHands       SimHand[]
  ratingModel    RatingModelState?
  scenarioHistory ScenarioHistory[]
  invitesCreated InviteCode[] @relation("InviteCreator")
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model UserPreference {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language        String   @default("en") // en | vi
  defaultMode     String   @default("practice") // practice | rated
  explanationView String   @default("quick") // quick | deep
  strategyView    String   @default("gto") // gto | exploit
  showBB          Boolean  @default(true)
  /// "Reset completion history": history before this instant is ignored for selection (nothing is deleted)
  historyResetAt  DateTime?
  updatedAt       DateTime @updatedAt
}

model SkillCategory {
  key    String @id
  nameEn String
  nameVi String
}

model SourceMetadata {
  id             String   @id @default(uuid())
  classification String // MATH_VERIFIED | SOLVER_VERIFIED | COACH_REVIEWED | HEURISTIC | EXPERIMENTAL
  methodEn       String
  methodVi       String
  reference      String?
  reviewedBy     String?
  createdAt      DateTime @default(now())

  versions ScenarioVersion[]
}

model Scenario {
  id             String   @id // content slug
  mode           String // hero | villain
  module         String
  currentVersion Int
  published      Boolean  @default(true)
  createdAt      DateTime @default(now())

  versions  ScenarioVersion[]
  bookmarks Bookmark[]
}

model ScenarioVersion {
  id               String   @id @default(uuid())
  scenarioId       String
  scenario         Scenario @relation(fields: [scenarioId], references: [id])
  version          Int
  contentHash      String
  definition       Json
  sourceId         String
  source           SourceMetadata @relation(fields: [sourceId], references: [id])
  difficulty       Int
  skills           String[]
  concepts         String[]
  validationReport Json
  validatedAt      DateTime @default(now())
  createdAt        DateTime @default(now())

  nodes    DecisionNode[]
  runs     ScenarioRun[]
  attempts DecisionAttempt[]

  @@unique([scenarioId, version])
}

model DecisionNode {
  id                String          @id @default(uuid())
  scenarioVersionId String
  scenarioVersion   ScenarioVersion @relation(fields: [scenarioVersionId], references: [id], onDelete: Cascade)
  nodeKey           String
  kind              String // decision | question
  skills            String[]
  concepts          String[]
  leakOpportunities String[]
  hasModel          Boolean @default(false)

  options  StrategyOption[]
  attempts DecisionAttempt[]

  @@unique([scenarioVersionId, nodeKey])
}

/// An answer option at a decision node together with its strategy reference.
model StrategyOption {
  id             String       @id @default(uuid())
  decisionNodeId String
  decisionNode   DecisionNode @relation(fields: [decisionNodeId], references: [id], onDelete: Cascade)
  optionKey      String
  actionType     String // fold | check | call | raise | allin | choice
  sizingMinBB    Float?
  sizingMaxBB    Float?
  sizingMinPot   Float?
  sizingMaxPot   Float?
  modelKey       String?
  rubricGrade    String?
  /// Solver-only fields; null unless the version's source is SOLVER_VERIFIED.
  solverFrequency Float?
  solverEv        Float?
  correct        Boolean?

  @@unique([decisionNodeId, optionKey])
}

model TrainingSession {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // hero | villain | math | review | imported | mixed
  mode      String // practice | rated
  /// Mixed Training: { durationMin, difficulty, focus[] } and the picker's history
  config    Json?
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  runs     ScenarioRun[]
  attempts DecisionAttempt[]

  @@index([userId, startedAt])
}

model ScenarioRun {
  id                String          @id @default(uuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId         String?
  session           TrainingSession? @relation(fields: [sessionId], references: [id])
  scenarioVersionId String
  scenarioVersion   ScenarioVersion @relation(fields: [scenarioVersionId], references: [id])
  mode              String // practice | rated
  status            String @default("active") // active | completed
  /// Hero actions / answers taken so far; the run state is rebuilt deterministically by replay.
  steps             Json   @default("[]")
  startedAt         DateTime @default(now())
  completedAt       DateTime?

  attempts DecisionAttempt[]

  @@index([userId, startedAt])
}

/// Immutable record of one graded (or ungraded) decision. Never updated after insert.
model DecisionAttempt {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientAttemptId      String
  sessionId            String?
  session              TrainingSession? @relation(fields: [sessionId], references: [id])
  runId                String?
  run                  ScenarioRun? @relation(fields: [runId], references: [id])
  scenarioVersionId    String?
  scenarioVersion      ScenarioVersion? @relation(fields: [scenarioVersionId], references: [id])
  decisionNodeId       String?
  decisionNode         DecisionNode? @relation(fields: [decisionNodeId], references: [id])
  attemptType          String // decision | question | quiz | imported
  itemRef              String // stable reference used for familiarity + review (e.g. scenarioId:nodeKey)
  mode                 String // practice | rated
  action               Json
  optionKey            String?
  graded               Boolean
  grade                String?
  gradeBasis           String // solverEv | modelEv | rubric | exact | none
  evLoss               Float?
  evUnit               String?
  score                Float?
  ratingEligible       Boolean
  ratingApplied        Boolean @default(false)
  ratingWeight         Float   @default(0)
  isError              Boolean
  confidence           Int?
  gradingMethodVersion String
  street               String?
  heroPosition         String?
  effectiveStackBB     Float?
  difficulty           Int
  skills               String[]
  concepts             String[]
  leakKeys             String[]
  result               Json
  /// fundamentals | replay | strategy — scores are never mixed across tracks
  track                String   @default("strategy")
  /// Hand family (real hands) for familiarity limits and train/assessment separation
  familyId             String?
  responseMs           Int?
  reasoning            String?
  /// Annotation version that graded this attempt (scores from different versions are not comparable)
  annotationId         String?
  createdAt            DateTime @default(now())

  ratingHistory    RatingHistory[]
  leakObservations LeakObservation[]

  @@unique([userId, clientAttemptId])
  @@index([userId, createdAt])
  @@index([userId, itemRef])
  /// familiarity / anti-farming lookups by hand family or solver-equivalent spot
  @@index([userId, familyId])
  /// Mixed Training and session summaries
  @@index([sessionId])
}

model Rating {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill      String // overall | preflop | ...
  rating     Float
  rd         Float
  vol        Float
  games      Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@id([userId, skill])
}

model RatingHistory {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  attemptId     String
  attempt       DecisionAttempt @relation(fields: [attemptId], references: [id])
  skill         String
  ratingBefore  Float
  rdBefore      Float
  volBefore     Float
  ratingAfter   Float
  rdAfter       Float
  volAfter      Float
  weight        Float
  score         Float
  opponentRating Float
  methodVersion String
  createdAt     DateTime @default(now())

  @@unique([attemptId, skill])
  @@index([userId, skill, createdAt])
}

model LeakObservation {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  attemptId String
  attempt   DecisionAttempt @relation(fields: [attemptId], references: [id])
  leakKey   String
  isError   Boolean
  evLossBB  Float?
  createdAt DateTime @default(now())

  @@index([userId, leakKey])
}

model ReviewItem {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType      String // scenario | quiz | imported
  itemRef       String
  repetitions   Int      @default(0)
  ease          Float    @default(2.5)
  intervalDays  Int      @default(0)
  dueAt         DateTime
  lastQuality   Int      @default(0)
  lapses        Int      @default(0)
  mastery       Float    @default(0)
  lastAttemptAt DateTime?
  lastGrade     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, itemType, itemRef])
  @@index([userId, dueAt])
}

model Bookmark {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id])
  createdAt  DateTime @default(now())

  @@id([userId, scenarioId])
}

model UserNote {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String // scenario | hand | attempt
  targetRef  String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, targetType, targetRef])
}

model ImportedFile {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename       String
  sha256         String
  sizeBytes      Int
  format         String?
  status         String // completed | failed
  handsParsed    Int @default(0)
  handsDuplicate Int @default(0)
  handsFailed    Int @default(0)
  createdAt      DateTime @default(now())

  hands  HandHistory[]
  errors ImportError[]

  @@index([userId, createdAt])
}

model Tournament {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  site       String
  externalId String
  name       String?
  createdAt  DateTime @default(now())

  hands HandHistory[]

  @@unique([userId, site, externalId])
}

model HandHistory {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  importedFileId String
  importedFile   ImportedFile @relation(fields: [importedFileId], references: [id], onDelete: Cascade)
  tournamentId   String?
  tournament     Tournament? @relation(fields: [tournamentId], references: [id])
  site           String
  externalHandId String
  playedAt       DateTime?
  heroName       String?
  heroPosition   String?
  tableSize      Int
  bigBlind       Int
  allIn          Boolean
  potComputed    Int
  raw            String
  parsed         Json
  /// Private to the owner unless explicitly shared.
  shared         Boolean @default(false)
  /// Heads-up push/fold decision graded against the equilibrium, when the hand contains one.
  gtoAudit       Json?
  hasGtoSpot     Boolean @default(false)
  createdAt      DateTime @default(now())

  actions HandAction[]

  @@unique([userId, site, externalHandId])
  @@index([userId, playedAt])
  @@index([userId, hasGtoSpot])
}

model HandAction {
  id      String      @id @default(uuid())
  handId  String
  hand    HandHistory @relation(fields: [handId], references: [id], onDelete: Cascade)
  seq     Int
  street  String
  player  String
  type    String
  amount  Int
  allIn   Boolean
  isHero  Boolean

  @@unique([handId, seq])
}

model ImportError {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  importedFileId String
  importedFile   ImportedFile @relation(fields: [importedFileId], references: [id], onDelete: Cascade)
  externalHandId String?
  message        String
  lineNo         Int?
  raw            String
  createdAt      DateTime @default(now())
}

/// A real hand from the owner's history (Real Hand Source v2 or upload). Private: the raw text,
/// future streets and showdowns never leave the server.
model RealHand {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  handId         String
  tournamentId   String?
  tournamentName String?
  format         String
  playedAt       DateTime?
  raw            String
  status         String // accepted | quarantined
  issues         Json
  notes          String[]
  /// training | assessment (by tournament, latest tournaments held out)
  split          String
  source         String // v2 | upload
  createdAt      DateTime @default(now())

  decisions RealDecision[]

  @@unique([userId, handId])
  @@index([userId, split])
}

/// A Hero decision point inside a real hand. `observed` is historical behaviour, not an answer.
model RealDecision {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalId   String
  realHandId   String
  realHand     RealHand @relation(fields: [realHandId], references: [id], onDelete: Cascade)
  familyId     String
  heroActionNo Int
  street       String
  status       String // accepted | quarantined
  issues       Json
  split        String
  format       String
  stackDepthBB Float
  potBB        Float
  toCallBB     Float
  investedBB   Float
  playersInPot Int
  multiway     Boolean
  facingAllIn  Boolean
  topics       String[]
  /// Supplied review tags (e.g. hero_all_in) describe observed actions: review queue only.
  reviewTags   String[]
  /// Observed historical action; hidden until the learner submits.
  observed     Json
  /// Pot-odds benchmark (Fundamentals) when the supplied quiz passed the audit.
  potOdds      Json?
  /// Normalized decision context (packages/core realhands/context.ts), for leak analysis
  position      String?
  actionContext String?
  heroAction    String?
  stackBucket   String?
  heroClass     String?
  spr           Float?
  facingBetPct  Float?
  requiredEq    Float?
  formatGroup   String?
  /// Heads-up push/fold solver verdict for this decision (chip EV), when the spot is an exact subgame
  pfAudit       Json?
  contextV      Int     @default(0)
  playedAt     DateTime?
  createdAt    DateTime @default(now())

  annotations Annotation[]

  @@unique([userId, externalId])
  @@index([userId, status, street])
  @@index([userId, street, actionContext])
  @@index([userId, split])
}

/// Versioned evaluation of a real decision. Never edited in place: a change is a new version.
model Annotation {
  id            String   @id @default(uuid())
  decisionId    String
  decision      RealDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation("AnnotationOwner", fields: [userId], references: [id], onDelete: Cascade)
  version       Int
  /// draft | verified | retired
  status        String   @default("draft")
  /// calculation | human | solver
  source        String
  /// human | ai | system — AI/system output always starts as draft
  authorKind    String
  infoAvailable Json
  assumedRanges Json
  economics     Json
  missingInfo   String[]
  /// [{ action, sizeToBB?, ev?, freq? }] — EV/freq only when genuinely computed
  evaluated     Json
  recommendation String
  explanationVi String
  explanationEn String?
  confidence    String // low | medium | high
  scope         String
  solverMeta    Json?
  toleranceBB   Float?
  verifiedById  String?
  verifiedAt    DateTime?
  supersedesId  String?
  createdAt     DateTime @default(now())

  @@unique([decisionId, version])
  @@index([userId, status])
}

/// A full hand played against modelled Villains. The deal (incl. the 5 board cards) is derived from
/// `seed` server-side and never sent to the client; state is rebuilt from seed + config + Hero steps.
model SimHand {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  seed        Int
  /// Hole cards + all five board cards, shuffled with a CSPRNG. Never sent to the client.
  deal        Json?
  config      Json
  modelVersion String
  mode        String    // practice | rated
  feedback    String    // guided | exam
  kind        String    @default("play") // play | replay | branch
  parentId    String?
  branchAt    Int?
  sessionId   String?
  /// Hero decisions: [{ action, confidence, reasoning, responseMs, clientAttemptId, attemptId }]
  steps       Json      @default("[]")
  version     Int       @default(0)
  status      String    @default("active") // active | complete | abandoned
  /// Strategic fingerprint (position, stack bucket, hand class, table, opponents, origin) for diversity
  fingerprint String?
  /// Exact-deal key (cards + config) to never repeat an identical hand
  exactKey    String?
  /// How the hand was created: random | scenario continuation | solver flop spot (with scripted prefix)
  origin      Json?
  bookmarked  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([userId, status, updatedAt])
  @@index([parentId])
  @@index([userId, fingerprint])
  @@index([userId, exactKey])
}

/// Which rating model a user's ratings follow. Moving to a new version back-fills new subratings
/// from immutable attempt history; existing ratings are never reset.
model RatingModelState {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version    String
  migratedAt DateTime @default(now())
  backfilled Int      @default(0)
}

/// Per-user, server-side history of curated scenarios and generated situations (cross-device).
/// Never deleted by "reset"; review / mastery come from ReviewItem, bookmarks from Bookmark.
model ScenarioHistory {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// scenario:<scenarioId> | sim:<fingerprint>
  contentKey     String
  module         String   // hero | villain | sim
  firstPlayedAt  DateTime @default(now())
  lastPlayedAt   DateTime @default(now())
  timesPlayed    Int      @default(0)
  timesCompleted Int      @default(0)
  correct        Int      @default(0)
  incorrect      Int      @default(0)
  /// correct | incorrect | ungraded
  lastResult     String?
  ratingEligible Boolean  @default(false)
  lastConfidence Int?
  firstRefId     String?
  lastRefId      String?

  @@unique([userId, contentKey])
  @@index([userId, module, lastPlayedAt])
}

/// Private lab: in production, signing up requires a single-use invite created by the owner.
/// Only a hash of the code is stored.
model InviteCode {
  id          String    @id @default(uuid())
  codeHash    String    @unique
  createdById String
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  note        String?
  usedById    String?
  usedAt      DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([createdById])
}
